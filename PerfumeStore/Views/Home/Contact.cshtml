@model PerfumeStore.Models.ContactMessage
@{
    ViewData["Title"] = System.Globalization.CultureInfo.CurrentCulture.Name == "ar" ? "تواصل معنا" : "Contact Us";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name == "ar";
}

<!-- Premium Page Header -->
<div class="page-header-premium text-center animate-fade-up">
    <div class="container">
        <h1 class="display-title">@(isArabic ? "نحن هنا لأجلك" : "We Are Here For You")</h1>
        <p class="subtitle">@(isArabic ? "تواصل معنا لأي استفسار، نحرص في نور للعود والعطور على أن نكون قريبين منكم دائماً." : "Contact us for any inquiry, at NourMakha we strive to always be close to you.")</p>
    </div>
</div>

<!-- Contact Section -->
<section class="contact-section">
    <div class="container">
        <div class="contact-grid-premium">
            
            <!-- Left Side: Contact Information -->
            <div class="contact-info-wrapper animate-fade-up delay-1">
                
                <!-- Quick Contact Cards -->
                <div class="info-cards-grid">
                    <!-- Phone -->
                    <div class="info-card-pro">
                        <div class="icon-wrapper"><i class="fas fa-phone-alt"></i></div>
                        <div class="content">
                            <h4>@(isArabic ? "خدمة العملاء" : "Customer Service")</h4>
                            <div class="contact-lines">
                                <span><strong class="flag">🇴🇲</strong> <span dir="ltr">98185589 | 96366332 | 92200207</span></span>
                                <span><strong class="flag">🇸🇦</strong> <span dir="ltr">+966 53 548 8493</span></span>
                                <span><strong class="flag">🇦🇪</strong> <span dir="ltr">+971 55 797 3809</span></span>
                            </div>
                        </div>
                    </div>

                    <!-- Email & Social -->
                    <div class="info-card-pro">
                        <div class="icon-wrapper"><i class="fas fa-envelope-open-text"></i></div>
                        <div class="content">
                            <h4>@(isArabic ? "المراسلة" : "Correspondence")</h4>
                            <div class="contact-lines">
                                <span><i class="fas fa-at"></i> info@nourmakha.com</span>
                                <span><i class="fab fa-instagram"></i> <a href="https://instagram.com/nourperfumes.om" target="_blank">@("@nourperfumes.om")</a></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Branches Section -->
                <div class="boutiques-section mt-4">
                    <h3 class="section-title-sm"><i class="fas fa-map-marked-alt"></i> @(isArabic ? "فروعنا ونقاط التوزيع" : "Boutiques & Presence")</h3>
                    
                    <div class="boutiques-list">
                        <div class="boutique-item">
                            <div class="b-header">
                                <span class="flag">🇴🇲</span>
                                <strong>@(isArabic ? "سلطنة عمان" : "Oman")</strong>
                            </div>
                            <p>@(isArabic ? "الموالح - صور - العامرات - المعبيلة - الخوير - الخوض - البريمي - صحم - صلالة" : "Mawaleh - Sur - Al Amerat - Ma'abela - Al Khuwair - Al Khoud - Al Buraimi - Saham - Salalah")</p>
                        </div>

                        <div class="boutique-item">
                            <div class="b-header">
                                <span class="flag">🇸🇦</span>
                                <strong>@(isArabic ? "السعودية" : "Saudi Arabia")</strong>
                            </div>
                            <p>@(isArabic ? "مكة - المدينة - جدة" : "Mecca - Medina - Jeddah")</p>
                        </div>

                        <div class="boutique-item">
                            <div class="b-header">
                                <span class="flag">🇦🇪</span>
                                <strong>@(isArabic ? "الإمارات العربية المتحدة" : "United Arab Emirates")</strong>
                            </div>
                            <p>@(isArabic ? "الشارقة - دبي - العين" : "Sharjah - Dubai - Al Ain")</p>
                        </div>
                    </div>
                </div>

                <!-- Wholesale VIP Notice -->
                <div class="wholesale-notice mt-4">
                    <div class="w-icon"><i class="fas fa-handshake"></i></div>
                    <div class="w-content">
                        <h4>@(isArabic ? "طلبات الجملة للأعمال" : "Wholesale & B2B Orders")</h4>
                        <p>
                            @(isArabic 
                                ? "لطلبات المتاجر بكميات الجملة، نرجو إرسال خطاب طلب معتمد من الشركة إلى بريدنا الإلكتروني الرسمي (info@nourmakha.com)." 
                                : "For store wholesale orders, please send an approved request letter from your company to our official email (info@nourmakha.com).")
                        </p>
                    </div>
                </div>

            </div>

            <!-- Right Side: The Form -->
            <div class="contact-form-wrapper animate-fade-up delay-2">
                <div class="form-card-premium">
                    <div class="form-header">
                        <h3>@(isArabic ? "أرسل رسالتك" : "Send Your Message")</h3>
                        <p>@(isArabic ? "سيسعد فريقنا بالرد عليك في أقرب وقت ممكن." : "Our team will be happy to respond to you as soon as possible.")</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert-success-modern">
                            <i class="fas fa-check-circle"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    <form asp-action="Contact" method="post" class="premium-form">
                        <div class="form-row-2">
                            <div class="form-group-float">
                                <input asp-for="Name" class="form-input" placeholder=" " required />
                                <label asp-for="Name">@(isArabic ? "الاسم الكريم" : "Full Name")</label>
                                <span asp-validation-for="Name" class="error-text"></span>
                            </div>
                            
                            <div class="form-group-float">
                                <input asp-for="Phone" class="form-input" placeholder=" " dir="ltr" />
                                <label asp-for="Phone">@(isArabic ? "رقم الهاتف" : "Phone Number")</label>
                            </div>
                        </div>

                        <div class="form-group-float">
                            <input asp-for="Email" type="email" class="form-input" placeholder=" " required dir="ltr" />
                            <label asp-for="Email">@(isArabic ? "البريد الإلكتروني" : "Email Address")</label>
                            <span asp-validation-for="Email" class="error-text"></span>
                        </div>

                        <div class="form-group-float">
                            <input asp-for="Subject" class="form-input" placeholder=" " required />
                            <label asp-for="Subject">@(isArabic ? "موضوع الرسالة" : "Subject")</label>
                            <span asp-validation-for="Subject" class="error-text"></span>
                        </div>

                        <div class="form-group-float">
                            <textarea asp-for="Message" class="form-input" rows="5" placeholder=" " required></textarea>
                            <label asp-for="Message">@(isArabic ? "تفاصيل الرسالة..." : "Message details...")</label>
                            <span asp-validation-for="Message" class="error-text"></span>
                        </div>

                        <button type="submit" class="btn-submit-premium">
                            <span>@(isArabic ? "إرسال الآن" : "Send Now")</span>
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* =======================================
       PREMIUM CONTACT PAGE STYLES
       ======================================= */
    
    .page-header-premium {
        padding: 6rem 0 3rem;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        margin-top: 80px;
        border-bottom: 1px solid rgba(0,40,85,0.05);
    }
    
    .display-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        color: #002855;
        margin-bottom: 1rem;
    }
    
    .subtitle {
        color: #64748b;
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .contact-section {
        padding: 4rem 0 6rem;
        background: #ffffff;
    }

    .contact-grid-premium {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    /* --- Left Info Styles --- */
    .info-cards-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .info-card-pro {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
        padding: 1.8rem;
        background: #fdfdfd;
        border: 1px solid #f1f5f9;
        border-radius: 20px;
        transition: all 0.3s ease;
    }

    .info-card-pro:hover {
        background: #ffffff;
        box-shadow: 0 15px 40px rgba(0,40,85,0.05);
        border-color: rgba(0,40,85,0.1);
        transform: translateY(-5px);
    }

    .icon-wrapper {
        width: 55px;
        height: 55px;
        background: linear-gradient(135deg, rgba(0,40,85,0.05) 0%, rgba(0,40,85,0.1) 100%);
        color: #002855;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .info-card-pro h4 {
        color: #1e293b;
        font-size: 1.1rem;
        margin-bottom: 1rem;
        font-weight: 700;
    }

    .contact-lines {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .contact-lines span {
        color: #64748b;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .contact-lines a {
        color: #64748b;
        text-decoration: none;
        transition: 0.3s;
    }
    
    .contact-lines a:hover { color: #002855; }
    
    .flag { font-size: 1.2rem; }

    /* Branches */
    .section-title-sm {
        font-size: 1.2rem;
        color: #002855;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
    }

    .boutiques-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .boutique-item {
        padding: 1.2rem 1.5rem;
        border-right: 3px solid #002855;
        background: #f8fafc;
        border-radius: 12px 0 0 12px;
    }
    body:not(.rtl) .boutique-item {
        border-right: none;
        border-left: 3px solid #002855;
        border-radius: 0 12px 12px 0;
    }

    .b-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .b-header strong {
        color: #1e293b;
        font-size: 1.05rem;
    }

    .boutique-item p {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* Wholesale Notice */
    .wholesale-notice {
        display: flex;
        gap: 1.2rem;
        padding: 1.5rem;
        background: #002855;
        color: #ffffff;
        border-radius: 20px;
        margin-top: 20px;
        box-shadow: 0 10px 30px rgba(0,40,85,0.15);
    }

    .w-icon {
        font-size: 2rem;
        color: #d4af37; /* Gold accent */
        opacity: 0.9;
    }

    .w-content h4 {
        color: #ffffff;
        margin: 0 0 0.5rem 0;
        font-size: 1.1rem;
    }

    .w-content p {
        margin: 0;
        color: rgba(255,255,255,0.8);
        font-size: 0.85rem;
        line-height: 1.6;
    }

    /* --- Right Form Styles --- */
    .form-card-premium {
        background: #ffffff;
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.04);
        position: sticky;
        top: 100px;
    }

    .form-header {
        margin-bottom: 2rem;
    }

    .form-header h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        color: #002855;
        margin-bottom: 0.5rem;
    }

    .form-header p {
        color: #94a3b8;
        font-size: 0.95rem;
    }

    /* Floating Inputs */
    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .form-group-float {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-input {
        width: 100%;
        padding: 1.2rem 1rem 0.8rem;
        background: #f8fafc;
        border: 1.5px solid transparent;
        border-radius: 12px;
        font-size: 1rem;
        color: #1e293b;
        transition: all 0.3s;
        font-family: inherit;
    }
    
    textarea.form-input {
        min-height: 120px;
        resize: vertical;
    }

    .form-input:focus {
        background: #ffffff;
        border-color: #002855;
        box-shadow: 0 0 0 4px rgba(0,40,85,0.05);
        outline: none;
    }

    .form-group-float label {
        position: absolute;
        left: 1rem;
        top: 1rem;
        color: #94a3b8;
        transition: 0.3s ease;
        pointer-events: none;
        font-size: 1rem;
    }

    .form-input:focus ~ label, .form-input:not(:placeholder-shown) ~ label {
        top: 0.3rem;
        left: 0.8rem;
        font-size: 0.75rem;
        color: #002855;
        font-weight: 700;
    }

    body.rtl .form-group-float label {
        left: auto;
        right: 1rem;
    }

    body.rtl .form-input:focus ~ label, body.rtl .form-input:not(:placeholder-shown) ~ label {
        right: 0.8rem;
        left: auto;
    }

    .error-text {
        display: block;
        color: #ef4444;
        font-size: 0.8rem;
        margin-top: 5px;
        margin-inline-start: 10px;
    }

    .btn-submit-premium {
        width: 100%;
        background: #002855;
        color: #ffffff;
        border: none;
        padding: 1.2rem;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 10px 20px rgba(0,40,85,0.15);
        margin-top: 1rem;
    }

    .btn-submit-premium:hover {
        background: #004080;
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(0,40,85,0.25);
    }

    .alert-success-modern {
        background: #ecfdf5;
        border: 1px solid #10b981;
        color: #059669;
        padding: 1.2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .contact-grid-premium {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
        
        .form-card-premium {
            padding: 2rem;
            position: static;
        }
    }

    @@media (max-width: 576px) {
        .form-row-2 {
            grid-template-columns: 1fr;
        }
        
        .display-title {
            font-size: 2.2rem;
        }
    }
</style>